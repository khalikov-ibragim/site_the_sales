# Secret for database
apiVersion: v1
kind: Secret
metadata:
  name: db-secret
  namespace: site-the-sales
type: Opaque
stringData:
  POSTGRES_USER: CHANGE_ME
  POSTGRES_DB: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME

---
# Secret for backend
apiVersion: v1
kind: Secret
metadata:
  name: back-secret
  namespace: site-the-sales
type: Opaque
stringData:
  DB_HOST: database
  DB_USER: CHANGE_ME
  DB_PORT: '5432'
  DB_PASSWORD: CHANGE_ME
  DB_NAME: CHANGE_ME
  SECRET_KEY: CHANGE_ME
  ALGORITHM: HS256

---
# Secret for pgAdmin
apiVersion: vtag: v1
kind: Secret
metadata:
  name: pgadmin-secret
  namespace: site-the-sales
type: Opaque
stringData:
  PGADMIN_DEFAULT_EMAIL: CHANGE_ME@example.com
  PGADMIN_DEFAULT_PASSWORD: CHANGE_ME
