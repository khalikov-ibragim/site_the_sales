#Указываем базовый образ
FROM python:3.11-slim 

#Создаем рабочую папку внутри контейнера внутри которой будут выполняться последнующие команды
WORKDIR /app 

#Копируем файл с зависимостями внутрь нашей рабочей папки 
COPY requirements.txt /app

#Устанавливаем пакеты из requirements а так же читаем список файла
RUN pip install -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple --timeout 60

#Копируем весь проект  в папку app
COPY . .

#Установка команды во время запуска контейнера 
CMD ["uvicorn","main:app", "--host", "0.0.0.0", "--port", "8000"]

#Увидели что пайтон приложение работает на веб сервере uvicorn, пишем команду uvicorn и к ней аргументы, где находится приложение для запуска
#Cинтаксис main:app = main = имя файла без .py, app = имя переменной внутри main.py которая содержит мое приложение где она = FastAPI
#а так же указание хоста (указали слушать все интерфейсы) так же указываем рабочий порт на котором будет работать наше приложение
#В терминале данная команда будет выглядеть как uvicorn main:app --host 0.0.0.0 --port 5432